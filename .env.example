# Copy this file to .env.local for local development.
# In Netlify: Site settings -> Environment variables -> add the same names there
# (Production, Deploy previews, Branch deploys as needed). Never commit real values.

# Google Gemini API key -- server-side only, used from Next.js Route Handlers
# (deployed as Netlify Functions). Never exposed to the browser. Used for both
# image damage detection (gemini-2.5-flash vision) and Google-Search-grounded
# live PH pricing (Repair vs. Replace / Buy Online).
GEMINI_API_KEY=

# ElevenLabs API key -- reserved for future voice/audio features. Server-side only.
ELEVENLABS_API_KEY=

# Mapbox: PUBLIC token, safe to expose client-side (must be prefixed
# NEXT_PUBLIC_ so Next.js inlines it into the browser bundle).
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_MAPBOX_STYLE=mapbox://styles/marwin2323/cmswv687u002u01so2xzd7mrs

# Base URL of the deployed site. Used for absolute URLs (share cards, OG tags).
# localhost: leave as-is. Netlify sets URL/DEPLOY_PRIME_URL automatically at build/runtime,
# so this is only a fallback for local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Telegram visit notifier -- SERVER-SIDE ONLY (read in src/proxy.ts).
# Deliberately NOT prefixed NEXT_PUBLIC_, so these never reach the browser.
# Both are already set in Netlify under these exact names:
#   locktight_dashboard = bot token from @BotFather (e.g. 8123456789:AAF...)
#   metrics_tag         = your NUMERIC chat id (not your @username)
# Find the numeric id with: node scripts/telegram-chat-id.mjs <BOT_TOKEN>
# Leave both empty to disable notifications entirely.
locktight_dashboard=
metrics_tag=
